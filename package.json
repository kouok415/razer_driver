{
  "name": "razer-driver",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "check:protocol": "node tools/check-protocol-doc.mjs --require=all --groups=all && node --test tools/",
    "test": "vitest run",
    "e2e": "playwright test",
    "preview": "vite preview",
    "verify": "npm run lint && npm run check:protocol && npm test && npm run build && npm run e2e"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/w3c-web-hid": "^1.0.7",
    "@types/w3c-web-usb": "^1.0.14",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.4"
  }
}
